@page "/socios/{Id}/editar"
@inject SocioService SocioService
@inject NavigationManager NavigationManager

<PageTitle>Editar socio · GimnasioPro</PageTitle>

<a class="back-link" href="socios">← Volver a la lista de socios</a>

@if (_cargado && _modelo is null)
{
    <div class="empty-state">
        <strong>Socio no encontrado</strong>
        <span class="empty-detail">El identificador recibido no corresponde a ningún socio.</span>
    </div>
}
else if (_modelo is not null)
{
    <div class="page-head">
        <div>
            <h1 class="page-title">Editar socio</h1>
            <p class="page-sub">Modifique los campos y confirme los cambios. La fecha de alta no se puede editar.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert alert-@_mensajeTipo">@_mensaje</div>
    }

    <div class="form-card">
        <EditForm Model="_modelo" OnValidSubmit="GuardarAsync" FormName="editarSocio">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-row">
                <div class="field">
                    <label class="field-label" for="nombre">Nombre *</label>
                    <InputText id="nombre" class="input" @bind-Value="_modelo.Nombre" />
                    <ValidationMessage For="() => _modelo.Nombre" />
                </div>
                <div class="field">
                    <label class="field-label" for="apellido">Apellido *</label>
                    <InputText id="apellido" class="input" @bind-Value="_modelo.Apellido" />
                    <ValidationMessage For="() => _modelo.Apellido" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label class="field-label" for="dni">DNI *</label>
                    <InputText id="dni" class="input" @bind-Value="_modelo.Dni" />
                    <ValidationMessage For="() => _modelo.Dni" />
                </div>
                <div class="field">
                    <label class="field-label" for="email">Correo electrónico *</label>
                    <InputText id="email" class="input" @bind-Value="_modelo.Email" />
                    <ValidationMessage For="() => _modelo.Email" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label class="field-label" for="telefono">Teléfono *</label>
                    <InputText id="telefono" class="input" @bind-Value="_modelo.Telefono" />
                    <ValidationMessage For="() => _modelo.Telefono" />
                </div>
                <div class="field">
                    <label class="field-label" for="nacimiento">Fecha de nacimiento *</label>
                    <InputDate id="nacimiento" class="input" @bind-Value="_modelo.FechaNacimiento" />
                    <ValidationMessage For="() => _modelo.FechaNacimiento" />
                </div>
            </div>

            @if (_cargado)
            {
                <div class="field">
                    <span class="field-label">Fecha de alta</span>
                    <span class="detail-value">@_modelo.FechaAlta.ToString("dd/MM/yyyy HH:mm")</span>
                    <span class="field-hint">Dato de solo lectura, asignado al crear el socio.</span>
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn-app btn-app-accent" disabled="@_guardando">Guardar cambios</button>
                <a class="btn-app btn-app-ghost" href="socios/@Id">Cancelar</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Socio? _modelo;
    private bool _cargado;
    private bool _guardando;
    private string? _mensaje;
    private string _mensajeTipo = "success";

    protected override async Task OnParametersSetAsync()
    {
        if (!ObjectId.TryParse(Id, out var socioId))
        {
            _cargado = true;
            return;
        }

        _modelo = await SocioService.GetPorIdAsync(socioId);
        _cargado = true;
    }

    private async Task GuardarAsync()
    {
        if (_modelo is null)
        {
            return;
        }

        if (_modelo.FechaNacimiento > DateTime.Today)
        {
            Error("La fecha de nacimiento no puede ser una fecha futura.");
            return;
        }

        _guardando = true;
        try
        {
            await SocioService.ActualizarAsync(_modelo);
            NavigationManager.NavigateTo(
                "/socios?mensaje=" + Uri.EscapeDataString("Los datos del socio se actualizaron correctamente."));
        }
        catch (Exception ex)
        {
            _guardando = false;
            Error($"No se pudieron guardar los cambios: {ex.Message}");
        }
    }

    private void Error(string texto)
    {
        _mensaje = texto;
        _mensajeTipo = "danger";
    }
}
