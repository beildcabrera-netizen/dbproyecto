@page "/actividades/{Id}/editar"
@inject ActividadService ActividadService
@inject NavigationManager NavigationManager

<PageTitle>Editar actividad · GimnasioPro</PageTitle>

<a class="back-link" href="actividades">← Volver a la lista de actividades</a>

@if (_cargado && _modelo is null)
{
    <div class="empty-state">
        <strong>Actividad no encontrada</strong>
        <span class="empty-detail">El identificador recibido no corresponde a ninguna actividad.</span>
    </div>
}
else if (_modelo is not null)
{
    <div class="page-head">
        <div>
            <h1 class="page-title">Editar actividad</h1>
            <p class="page-sub">Modifique los campos y confirme los cambios.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert alert-@_mensajeTipo">@_mensaje</div>
    }

    <div class="form-card">
        <EditForm Model="_modelo" OnValidSubmit="GuardarAsync" FormName="editarActividad">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-row">
                <div class="field">
                    <label class="field-label" for="nombre">Nombre *</label>
                    <InputText id="nombre" class="input" @bind-Value="_modelo.Nombre" />
                    <ValidationMessage For="() => _modelo.Nombre" />
                </div>
                <div class="field">
                    <label class="field-label" for="categoria">Categoría *</label>
                    <InputText id="categoria" class="input" @bind-Value="_modelo.Categoria" />
                    <ValidationMessage For="() => _modelo.Categoria" />
                </div>
            </div>

            <div class="form-row">
                <div class="field">
                    <label class="field-label" for="horario">Horario *</label>
                    <InputText id="horario" class="input" @bind-Value="_modelo.Horario" />
                    <ValidationMessage For="() => _modelo.Horario" />
                    <span class="field-hint">Formato: HH:MM - HH:MM</span>
                </div>
                <div class="field">
                    <label class="field-label" for="dia">Día de la semana *</label>
                    <InputSelect id="dia" class="select" @bind-Value="_modelo.DiaSemana">
                        <option value="">Seleccione…</option>
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sábado">Sábado</option>
                        <option value="Domingo">Domingo</option>
                    </InputSelect>
                    <ValidationMessage For="() => _modelo.DiaSemana" />
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="cupo">Cupo máximo *</label>
                <InputNumber id="cupo" class="input" @bind-Value="_modelo.CupoMaximo" ParsingErrorMessage="El campo {0} debe ser un número." />
                <ValidationMessage For="() => _modelo.CupoMaximo" />
                <span class="field-hint">Si el cupo ya está completo, el botón «Nueva inscripción» mostrará el error de límite.</span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-app btn-app-accent" disabled="@_guardando">Guardar cambios</button>
                <a class="btn-app btn-app-ghost" href="actividades">Cancelar</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Actividad? _modelo;
    private bool _cargado;
    private bool _guardando;
    private string? _mensaje;
    private string _mensajeTipo = "success";

    protected override async Task OnParametersSetAsync()
    {
        if (ObjectId.TryParse(Id, out var actividadId))
        {
            _modelo = await ActividadService.GetPorIdAsync(actividadId);
        }

        _cargado = true;
    }

    private async Task GuardarAsync()
    {
        if (_modelo is null)
        {
            return;
        }

        _guardando = true;
        try
        {
            await ActividadService.ActualizarAsync(_modelo);
            NavigationManager.NavigateTo(
                "/actividades?mensaje=" + Uri.EscapeDataString("Los datos de la actividad se actualizaron correctamente."));
        }
        catch (Exception ex)
        {
            _guardando = false;
            _mensaje = $"No se pudieron guardar los cambios: {ex.Message}";
            _mensajeTipo = "danger";
        }
    }
}
