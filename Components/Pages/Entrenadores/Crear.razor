@page "/entrenadores/crear"
@inject EntrenadorService EntrenadorService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo entrenador · GimnasioPro</PageTitle>

<a class="back-link" href="entrenadores">← Volver a la lista de entrenadores</a>

<div class="page-head">
    <div>
        <h1 class="page-title">Nuevo entrenador</h1>
        <p class="page-sub">Complete los datos del alta. Los campos con <strong>*</strong> son obligatorios.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="alert alert-@_mensajeTipo">@_mensaje</div>
}

<div class="form-card">
    <EditForm Model="_modelo" OnValidSubmit="GuardarAsync" FormName="crearEntrenador">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-row">
            <div class="field">
                <label class="field-label" for="nombre">Nombre *</label>
                <InputText id="nombre" class="input" @bind-Value="_modelo.Nombre" placeholder="Ej.: Franco" />
                <ValidationMessage For="() => _modelo.Nombre" />
            </div>
            <div class="field">
                <label class="field-label" for="apellido">Apellido *</label>
                <InputText id="apellido" class="input" @bind-Value="_modelo.Apellido" placeholder="Ej.: Ferrara" />
                <ValidationMessage For="() => _modelo.Apellido" />
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label class="field-label" for="email">Correo electrónico *</label>
                <InputText id="email" class="input" @bind-Value="_modelo.Email" placeholder="nombre@correo.com" />
                <ValidationMessage For="() => _modelo.Email" />
            </div>
            <div class="field">
                <label class="field-label" for="telefono">Teléfono *</label>
                <InputText id="telefono" class="input" @bind-Value="_modelo.Telefono" placeholder="Ej.: 11-5555-0000" />
                <ValidationMessage For="() => _modelo.Telefono" />
            </div>
        </div>

        <div class="form-row">
            <div class="field">
                <label class="field-label" for="especialidad">Especialidad *</label>
                <InputText id="especialidad" class="input" @bind-Value="_modelo.Especialidad" placeholder="Ej.: Fuerza y acondicionamiento" />
                <ValidationMessage For="() => _modelo.Especialidad" />
            </div>
            <div class="field">
                <label class="field-label" for="contratacion">Fecha de contratación *</label>
                <InputDate id="contratacion" class="input" @bind-Value="_modelo.FechaContratacion" />
                <ValidationMessage For="() => _modelo.FechaContratacion" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-app btn-app-accent" disabled="@_guardando">Guardar entrenador</button>
            <a class="btn-app btn-app-ghost" href="entrenadores">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private Entrenador _modelo = new();
    private bool _guardando;
    private string? _mensaje;
    private string _mensajeTipo = "success";

    private async Task GuardarAsync()
    {
        _guardando = true;
        try
        {
            await EntrenadorService.CrearAsync(_modelo);
            NavigationManager.NavigateTo(
                "/entrenadores?mensaje=" + Uri.EscapeDataString("El entrenador se creó correctamente."));
        }
        catch (Exception ex)
        {
            _guardando = false;
            Error($"No se pudo crear el entrenador: {ex.Message}");
        }
    }

    private void Error(string texto)
    {
        _mensaje = texto;
        _mensajeTipo = "danger";
    }
}
