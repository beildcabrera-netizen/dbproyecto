@page "/entrenadores/{Id}"
@inject EntrenadorService EntrenadorService
@inject RutinaService RutinaService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Detalle de entrenador · GimnasioPro</PageTitle>

<a class="back-link" href="entrenadores">← Volver a la lista de entrenadores</a>

@if (!string.IsNullOrEmpty(_mensaje))
{
    <div class="alert alert-@_mensajeTipo">@_mensaje</div>
}

@if (_error is not null)
{
    <div class="empty-state">
        <strong>Entrenador no encontrado</strong>
        <span class="empty-detail">@_error</span>
    </div>
}
else if (_entrenador is not null)
{
    <div class="page-head">
        <div>
            <h1 class="page-title">@_entrenador.Nombre @_entrenador.Apellido</h1>
            <p class="page-sub">@_entrenador.Especialidad · entrenador con relación <strong>1:N</strong> hacia las rutinas.</p>
        </div>
        <div class="cell-actions">
            <a class="btn-app btn-app-accent" href="rutinas/crear?entrenadorId=@_entrenador.Id">+ Nueva rutina</a>
            <a class="btn-app btn-app-dark" href="entrenadores/@_entrenador.Id/editar">Editar</a>
            <button class="btn-app btn-app-danger" @onclick="DesactivarAsync">Desactivar</button>
        </div>
    </div>

    <section class="panel">
        <div class="panel-head">
            <h2>Datos del entrenador</h2>
            <span class="pill @(_entrenador.Activo ? "pill-ok" : "pill-off")">@(_entrenador.Activo ? "Activo" : "Inactivo")</span>
        </div>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">Nombre completo</span>
                <span class="detail-value">@_entrenador.Nombre @_entrenador.Apellido</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Correo electrónico</span>
                <span class="detail-value">@_entrenador.Email</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Teléfono</span>
                <span class="detail-value mono">@_entrenador.Telefono</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Especialidad</span>
                <span class="detail-value">@_entrenador.Especialidad</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Fecha de contratación</span>
                <span class="detail-value">@_entrenador.FechaContratacion.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Sus rutinas <span class="rel-tag rel-one-many">1:N</span></h2>
            <span class="pill pill-outline">@_rutinas.Count activas</span>
        </div>

        @if (_rutinas.Count == 0)
        {
            <div class="empty-state">
                <strong>No hay registros</strong>
                <span class="empty-detail">Este entrenador todavía no tiene rutinas activas.</span>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Rutina</th>
                            <th>Dificultad</th>
                            <th>Duración</th>
                            <th>Creada</th>
                            <th class="col-actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rutina in _rutinas)
                        {
                            <tr>
                                <td data-label="Rutina">
                                    <span class="cell-strong">@rutina.Nombre</span>
                                    <span class="cell-sub">@rutina.Descripcion</span>
                                </td>
                                <td data-label="Dificultad">
                                    <span class="pill pill-@rutina.Dificultad.ToLowerInvariant()">@rutina.Dificultad</span>
                                </td>
                                <td data-label="Duración">@rutina.DuracionDias días</td>
                                <td data-label="Creada">@rutina.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td data-label="Acciones">
                                    <div class="cell-actions">
                                        <a class="btn-app btn-app-sm btn-app-dark" href="rutinas/@rutina.Id/editar">Editar rutina</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Entrenador? _entrenador;
    private List<Rutina> _rutinas = new();
    private string? _error;
    private string? _mensaje;
    private string _mensajeTipo = "success";

    protected override async Task OnParametersSetAsync()
    {
        if (!ObjectId.TryParse(Id, out var entrenadorId))
        {
            _error = "El identificador del entrenador no es válido.";
            return;
        }

        try
        {
            _entrenador = await EntrenadorService.GetPorIdAsync(entrenadorId);
            if (_entrenador is null)
            {
                _error = "El entrenador indicado no existe.";
                return;
            }

            _rutinas = await RutinaService.GetActivasPorEntrenadorAsync(entrenadorId);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo consultar MongoDB: {ex.Message}";
        }
    }

    private async Task DesactivarAsync()
    {
        if (_entrenador is null)
        {
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Seguro que desea desactivar a {_entrenador.Nombre} {_entrenador.Apellido}? Se realizará un borrado lógico (Activo = false).");

        if (!confirmado)
        {
            return;
        }

        try
        {
            await EntrenadorService.DesactivarAsync(_entrenador.Id);
            NavigationManager.NavigateTo(
                "/entrenadores?mensaje=" + Uri.EscapeDataString("El entrenador fue desactivado (borrado lógico)."));
        }
        catch (Exception ex)
        {
            _mensaje = $"No se pudo desactivar el entrenador: {ex.Message}";
            _mensajeTipo = "danger";
        }
    }
}
